# Gate credentials for the deployed prototype. Vite inlines these into the
# client bundle at build time — this is a soft gate to keep the demo out of
# search engines and casual visitors, not real authentication. For a real
# deployment, set these in the hosting provider's environment settings
# rather than committing production values here.
VITE_AUTH_USERNAME=diligent
VITE_AUTH_PASSWORD=gcpersona
